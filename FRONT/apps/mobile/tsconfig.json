{
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@app/constants": ["../../packages/constants/src"],
      "@app/tokens": ["../../packages/tokens/src"],
      "@app/schemas": ["../../packages/schemas/src"],
      "@app/api": ["../../packages/api/src"],
      "@app/api/zod": ["../../packages/api/src/zod.ts"],
      "@/components": ["./src/components"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/*/src/**/*.ts",
    "../../packages/*/src/**/*.tsx"
  ]
}
